{
  "name": "folkways",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "build": "gradle build",
    "setup": "node_modules/@izakyl/blockwright-client/dist/blockwright mods sync --config blockwright.toml",
    "setup:promo-models": "python3 tests/promo/models/vendor.py",
    "typecheck": "tsc -p tests/e2e && tsc -p tests/sable && tsc -p tests/visual && tsc -p tests/ponder && tsc -p tests/pattern && tsc -p tests/bench && tsc -p tests/promo && tsc -p tests/i18n",
    "test:unit": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:i18n": "node --test --experimental-strip-types tests/i18n/lang.test.ts",
    "test:e2e": "npm exec -- playwright test --config tests/e2e/playwright.config.ts",
    "test:sable": "npm exec -- playwright test --config tests/sable/playwright.config.ts",
    "test:coverage": "npm run coverage:reset && BLOCKWRIGHT_COVERAGE=1 npm run test:e2e; status=$?; BLOCKWRIGHT_COVERAGE=1 npm run test:sable || status=$?; npm run coverage:report && exit $status",
    "coverage:report": "node_modules/@izakyl/blockwright-client/dist/blockwright coverage report --config blockwright.toml",
    "coverage:reset": "node_modules/@izakyl/blockwright-client/dist/blockwright coverage reset --config blockwright.toml",
    "visual:take": "npm exec -- playwright test --config tests/visual/playwright.config.ts",
    "ponder:take": "npm exec -- playwright test --config tests/ponder/playwright.config.ts",
    "pattern:take": "npm exec -- playwright test --config tests/pattern/playwright.config.ts",
    "bench:take": "npm exec -- playwright test --config tests/bench/playwright.config.ts",
    "bench:overlay": "node --experimental-strip-types tests/bench/film/overlay.ts",
    "promo:take": "npm exec -- playwright test --config tests/promo/playwright.config.ts",
    "promo:cookery": "npm run promo:take -- cookery.take.ts",
    "promo:cookery:film": "python3 tests/promo/film/cookery.py"
  },
  "devDependencies": {
    "@izakyl/blockwright-cinema": "0.1.0-alpha.1",
    "@izakyl/blockwright-client": "0.1.0-alpha.1",
    "@izakyl/blockwright-mcp": "0.1.0-alpha.1",
    "@izakyl/blockwright-minecraft": "0.1.0-alpha.1",
    "@izakyl/blockwright-test": "0.1.0-alpha.1",
    "@izakyl/blockwright-ui": "0.1.0-alpha.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "typescript": "^5.0.0"
  }
}
