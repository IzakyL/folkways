{
  "name": "folkways",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "./gradlew build",
    "setup": "node tests/shared/blockwright-cli.mjs mods sync --config blockwright.toml",
    "setup:promo-models": "python3 tests/promo/models/vendor.py",
    "typecheck": "tsc -p tests/e2e && tsc -p tests/sable && tsc -p tests/visual && tsc -p tests/pattern && tsc -p tests/bench && tsc -p tests/promo",
    "test:unit": "node --test --experimental-strip-types \"tests/**/*.test.ts\"",
    "test:e2e": "npm exec -- playwright test --config tests/e2e/playwright.config.ts",
    "test:sable": "npm exec -- playwright test --config tests/sable/playwright.config.ts",
    "test:coverage": "npm run coverage:reset && BLOCKWRIGHT_COVERAGE=1 npm run test:e2e; status=$?; BLOCKWRIGHT_COVERAGE=1 npm run test:sable || status=$?; npm run coverage:report && exit $status",
    "coverage:report": "node tests/shared/blockwright-cli.mjs coverage report --config blockwright.toml",
    "coverage:reset": "node tests/shared/blockwright-cli.mjs coverage reset --config blockwright.toml",
    "visual:take": "npm exec -- playwright test --config tests/visual/playwright.config.ts",
    "ponder:take": "npm run visual:take -- -g ponder",
    "pattern:take": "npm exec -- playwright test --config tests/pattern/playwright.config.ts",
    "bench:take": "npm exec -- playwright test --config tests/bench/playwright.config.ts",
    "bench:overlay": "node --experimental-strip-types tests/bench/film/overlay.ts",
    "promo:take": "npm exec -- playwright test --config tests/promo/playwright.config.ts",
    "promo:cookery": "npm run promo:take -- cookery-kitchen.take.ts cookery-wine.take.ts create-elevator.take.ts",
    "promo:cookery:film": "python3 tests/promo/film/cookery.py",
    "promo:combat": "npm run promo:take -- combat-rts.take.ts combat-squads.take.ts combat-emplacements.take.ts combat-damage.take.ts",
    "promo:combat:repair": "npm run promo:take -- combat-repair.take.ts",
    "promo:combat:sites": "npm run promo:take -- combat-site.take.ts",
    "promo:combat:film": "python3 tests/promo/film/combat.py",
    "promo:mounted": "npm run promo:take -- mounted.take.ts",
    "promo:mounted:carts": "npm run promo:take -- carts.take.ts",
    "promo:mounted:film": "python3 tests/promo/film/mounted.py",
    "test:airline:shards": "node tests/airline/gametest-shards.mjs",
    "test:airline": "node tests/airline/tower.mjs",
    "promo:debug": "npm run promo:take -- debug-overlay.take.ts",
    "promo:debug:film": "python3 tests/promo/film/debug.py",
    "promo:storage": "npm run promo:take -- storage.take.ts",
    "promo:storage:film": "python3 tests/promo/film/storage.py",
    "promo:airport": "npm run promo:take -- airport.take.ts",
    "promo:airport:film": "python3 tests/promo/film/airport.py",
    "promo:assistant": "npm run promo:take -- assistant-rail.take.ts assistant-door.take.ts assistant-smelter.take.ts assistant-walker.take.ts assistant-drill.take.ts --workers=1",
    "promo:assistant:film": "python3 tests/promo/film/assistant.py"
  },
  "devDependencies": {
    "@izakyl/blockwright-cinema": "0.1.0-alpha.3",
    "@izakyl/blockwright-client": "0.1.0-alpha.3",
    "@izakyl/blockwright-mcp": "0.1.0-alpha.3",
    "@izakyl/blockwright-minecraft": "0.1.0-alpha.3",
    "@izakyl/blockwright-test": "0.1.0-alpha.3",
    "@izakyl/blockwright-ui": "0.1.0-alpha.3",
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
